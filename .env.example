# StudyFlow environment variables — PLACEHOLDERS ONLY.
#
# Copy to .env.local and fill in real values. .env.local is gitignored; never commit real
# credentials, and never rename any of these to NEXT_PUBLIC_* — Next.js inlines those into the
# browser bundle, which would publish the secret to every visitor.
#
# All four are optional. Without them StudyFlow runs normally and simply reports that Google
# Classroom isn't set up. See docs/google-classroom-setup.md for how to obtain them.

# OAuth client ID from Google Cloud Console → APIs & Services → Credentials.
GOOGLE_CLIENT_ID=

# OAuth client secret from the same screen. Server-side only.
GOOGLE_CLIENT_SECRET=

# Must match an Authorized redirect URI on the OAuth client exactly — scheme, host, port, path and
# trailing slash are all compared literally by Google.
#   local:      http://localhost:3000/api/integrations/google-classroom/callback
#   production: https://<your-domain>/api/integrations/google-classroom/callback
GOOGLE_REDIRECT_URI=

# Key for encrypting the connection cookie that holds the Google refresh token. At least 32
# characters of random data — generate with:  openssl rand -base64 48
# Changing it disconnects Google Classroom for everyone; no StudyFlow data is affected.
STUDYFLOW_SESSION_SECRET=
